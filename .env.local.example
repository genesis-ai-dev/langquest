# LangQuest Local Development Environment Variables
# This file is used as a template to generate .env.local
# LOCAL_IP will be automatically replaced with your machine's local IP address

# Supabase Configuration
# Get these values after running: npx supabase status
# Or check: http://localhost:54323 (Supabase Studio) -> Settings -> API
EXPO_PUBLIC_SUPABASE_URL=http://LOCAL_IP:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
EXPO_PUBLIC_SUPABASE_BUCKET=local
EXPO_PUBLIC_APP_VARIANT=development

# PowerSync Configuration
EXPO_PUBLIC_POWERSYNC_URL=http://LOCAL_IP:8000
PS_PORT=8000
# PostgreSQL connection string for PowerSync (uses Docker network 'db' hostname)
PS_DATA_SOURCE_URI=postgresql://postgres:postgres@db:5432/postgres

# Site URL for auth redirects (Expo dev server default)
EXPO_PUBLIC_SITE_URL=http://LOCAL_IP:8081

# Inbucket inbox URL for local email testing (Supabase Inbucket)
EXPO_PUBLIC_RESEND_LOCAL_INBOX_URL=http://LOCAL_IP:4000/inbox

# Optional: PostHog Analytics (leave empty for local dev)
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=
# EXPO_PUBLIC_POSTHOG_DISABLED=true

# PostHog CLI — source map uploads (EAS Build / after `eas update`)
# Personal API key with error tracking write + organization read scopes.
# Set these in EAS environment secrets for preview/production (not in the app bundle).
# POSTHOG_CLI_PROJECT_ID=
# POSTHOG_CLI_API_KEY=


# Local stack service role key for Node-side tooling: Maestro
# (testing/maestro-local.ts) and scripts/ (create-test-user, import-timestamps,
# attachment benchmarks). Not read by the Supabase CLI: the vault and edge
# runtime secrets come from SERVICE_ROLE_KEY in supabase/.env.local.
# Get the value from: npm run sb -- status
SUPABASE_SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Maestro local (`npm run maestro:local`) reads these if set, otherwise
# derives them from EXPO_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# EXPO_PUBLIC_SITE_URL, and EXPO_PUBLIC_APP_VARIANT.
# MAESTRO_APP_VARIANT picks which installed build Maestro drives
# (development | preview | production) without changing EXPO_PUBLIC_APP_VARIANT.
# Non-development variants skip the Expo dev-client launch steps.
# MAESTRO_APP_VARIANT=preview
# MAESTRO_APP_ID=com.etengenesis.langquest.development
# MAESTRO_SUPABASE_URL=http://LOCAL_IP:54321
# MAESTRO_SUPABASE_SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz
# MAESTRO_SITE_URL=http://LOCAL_IP:8081
# MAESTRO_METRO_URL=http://LOCAL_IP:8081
